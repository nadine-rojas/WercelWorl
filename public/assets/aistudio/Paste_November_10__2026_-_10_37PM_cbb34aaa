function spawnEnt(type,x,y,z,extra={}){
  const id=eid++;
  const e={id,type,pos:new THREE.Vector3(x,y,z),vel:new THREE.Vector3(),
    state:'idle',timer:0,alive:true,hp:3,...extra};
  let g;
  if(type==='fish')     g=mkFishSimple();
  else if(type==='shark')g=mkSharkSimple();
  else if(type==='zombie')g=mkZombie();
  else if(type==='villager')g=mkVillagerMesh();
  else if(type==='wolf'||type==='wolf_t')g=mkWolfMesh(type==='wolf_t');
  else if(type==='cow')g=mkCow();
  else if(type==='sheep')g=mkSheep();
  else if(type==='chicken')g=mkChicken();
  else if(type==='rabbit')g=mkRabbit();
  else if(type==='horse')g=mkHorse();
  else if(type==='capybara')g=mkCapybara();
  else if(type==='parrot')g=mkParrot(extra.parrotColor||0xCC2222);
  else if(type==='turtle')g=mkTurtle();
  else if(type==='enderman')g=mkEnderman();
  if(g){g.position.copy(e.pos);g.userData.eid=id;scene.add(g);e.mesh=g;}
  ENT.push(e);return e;
}

