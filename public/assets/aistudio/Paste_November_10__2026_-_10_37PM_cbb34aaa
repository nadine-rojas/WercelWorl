.dmg{position:absolute;inset:0;background:rgba(200,0,0,0);transition:background .15s;pointer-events:none;border-radius:0;}
.wolves{position:absolute;bottom:88px;left:12px;background:rgba(0,0,0,.6);padding:4px 10px;border-radius:6px;font-size:10px;color:#e2e8f0;border:1px solid rgba(255,255,255,.1);display:none;}
