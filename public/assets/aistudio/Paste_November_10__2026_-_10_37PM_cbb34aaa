.tgt{position:absolute;top:8px;right:8px;background:rgba(0,0,0,.65);padding:7px 11px;border-radius:8px;font-size:10px;color:#e2e8f0;line-height:1.8;border:1px solid rgba(255,255,255,.1);font-family:Consolas,monospace;min-width:130px;}
.pname{position:absolute;top:8px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.55);padding:3px 14px;border-radius:20px;font-size:12px;font-weight:700;border:1px solid rgba(255,255,255,.15);}
.hpbar{position:absolute;bottom:68px;right:12px;background:rgba(0,0,0,.6);padding:4px 10px;border-radius:6px;font-size:10px;color:#e2e8f0;border:1px solid rgba(255,255,255,.1);}
